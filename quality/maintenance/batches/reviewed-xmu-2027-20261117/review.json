    "eligibility": [
      {
        "zh": "年龄18–30周岁（截止2027年9月1日前），身心健康，持外国有效普通护照的非中国籍公民；未满18周岁者须提供监护担保书。"
      },
      {
        "zh": "高中毕业或应届高中毕业，具备大学申请资格，学业成绩良好。"
      },
      {
        "zh": "外籍华人等须按申请系统要求提交国籍状况预审材料，并在入学时携带相关纸质文件；未通过国籍预审或入学后国籍认定者，丧失申请、入学或学籍资格。"
      },
      {
        "zh": "适用国籍法及教育部要求的出生即获外籍的华裔或移民转国籍申请者，须持有效外国护照或国籍证明4年（含）以上，且截至2027年4月30日前最近4年内实际在外国居住2年以上；一年内实际境外居住满9个月可按一年计算，以出入境签章为准。"
      },
      {
        "zh": "须提交CSCA成绩单；经管法类必考文科中文和数学，数学测试语言须与授课语言一致。汉语言专业适用的HSK免考专业中文规则不适用于本经济学院专业。"
      },
      {
        "zh": "奖学金申请者还须符合对应奖学金的年龄及其他要求；本周期仅为自费生申请轮次。"
      }
    ],
    "languageRequirements": [
      {
        "test": "HSK",
        "minimum": "5级210分及以上；高中阶段中文授课者可提供高中授课语言证明代替HSK证书；马来西亚华文独立中学学生可提交统考（UEC）成绩单作为替代文件。"
      }
    ],
    "allEvidence": [
      {
        "sourceName": "guide-cn",
