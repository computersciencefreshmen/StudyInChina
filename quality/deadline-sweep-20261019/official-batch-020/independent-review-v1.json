  "findings": [
    {
      "key": "gxtcmu-year-from-body-route-and-degree-tables",
      "disposition": "accepted-with-award-scope-only",
      "assessment": "A 2023 URL segment does not set the document year. Actual title, literal May25,2026 cutoff, 2026 email subject and September2026 entry independently bind the current source. Sections3.1,3.2,3.3 separately match Chinese Medicine and Acupuncture/Tuina bachelors, Chinese Internal Medicine master, and History/Literature of Chinese Medicine doctorate. All four cycles and the named award are supported only for this Guangxi Government ASEAN full-scholarship route; no universal self-funded cutoff is certified. Review/approval and July–August admission-document mailing are later stages.",
      "observedDeadline": "2026-05-25"
    },
    {
      "key": "gxmu-general-vs-asean-vs-president-award",
      "disposition": "accepted-with-separate-scopes",
      "assessment": "The 2026 undergraduate guide itself names Chinese-medium Clinical Medicine, six-year English MBBS and Stomatology with a January1–August15 fall application period; 2026 is contextual in the same year-specific guide rather than repeated beside the month/day range. The dedicated 2026 ASEAN notice instead requires applicant submission before May10; strict before qualifier is preserved for both canonical IDs referring to that one award. HSK completion by July2027, CSCA scores by July30 (or15 days before an award deadline), provincial review and individual deposit conditions do not replace the applicant window. President scholarship is automatic ranking only after admitted self-funded students register and pay; no exact deadline is invented.",
      "generalDeadline": "2026-08-15",
      "aseanDeadline": "2026-05-10",
      "aseanBoundary": "before-date-as-worded",
      "presidentDeadline": null
    },
    {
      "key": "gdut-language-perennial-reference",
      "disposition": "accepted-unknown",
      "assessment": "The language-training subsection says perennial recruitment; the separate June30,2026 day is for degree students. The spring title and later August–September2026 registration paragraph do not establish an exact current language intake. Report appropriately retains unknown and does not declare unconditional current opening."
    },
    {
      "key": "gxnu-table-column-and-undated-year",
      "disposition": "accepted-unknown",
      "assessment": "Original PDFpage1 and rendered image were read. Chinese Language and Literature is a Chinese-taught doctoral row; its Application Deadline column says June30,Each Year and its Enrollment Date column says Sep. These must not be swapped. The two-page list establishes no exact application year; unknown is correct.",
      "visualEvidence": "gxnu-rule-page1.png"
    },
    {
      "key": "gxu-fees-not-date-evidence",
      "disposition": "accepted-unknown",
      "assessment": "Both language degree/nondegree records are sourced to a fee page. Full captured page gives charges and semester/year units with no application date. No target-year cutoff is inferred."
    },
    {
      "key": "gxmzu-wrapper200-vs-unread-pdf",
      "disposition": "accepted-blocked",
      "assessment": "Two stored official wrappers contain year-specific titles and attachments; neither wrapper establishes the full award date. Original PDF GET returned200 headers but timed out before a body/hash was saved, then one bounded web fallback failed. The report correctly distinguishes wrapper bytes from the absent original PDF and keeps the award blocked under cooldown."
    },
    {
      "key": "gafa-inclusive-applicant-deadline",
      "disposition": "accepted-date-only",
      "assessment": "The full 2026 international doctoral call identifies Chinese-medium/fulltime doctorate and Art Studies among its doctoral points. Its applicant-email subsection explicitly ends April17,2026 inclusive of that day. Publication-relative opening, later interview notice, passport validity and September registration are not substituted for the application cutoff. Programme-catalogue attachment facts are not independently certified by this review.",
      "observedDeadline": "2026-04-17",
      "boundary": "inclusive-date-as-worded"
    }
