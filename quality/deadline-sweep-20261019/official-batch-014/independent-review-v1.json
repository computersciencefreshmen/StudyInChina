  "findings": [
    {
      "key": "cad-bachelor-distinct-application-stages",
      "disposition": "accepted",
      "evidence": [
        "cad-bachelor-guide.pdf pages 3,7,8,10",
        "cad-bachelor-date-page3.png",
        "independent-cad-stage-page-07.png",
        "independent-cad-stage-page-08.png"
      ],
      "assessment": "2026 international undergraduate first application-material submission runs March 2 at 09:00 to March 6 at 09:00 Beijing time. March 16 at 17:00 applies only to major selection/payment after review, and before April 15 applies only to qualification documents after successful registration. The earliest mandatory first-submission cutoff is the correct scoped candidate for a new applicant; later stages cannot replace it.",
      "candidateCutoffAt": "2026-03-06T09:00:00+08:00",
      "relativeOrBeforeQualifiersPreserved": true
    },
    {
      "key": "cad-doctor-foreign-vs-hmt-route",
      "disposition": "accepted",
      "evidence": [
        "cad-doctor-guide.pdf page 1",
        "cad-doctor-date-page1.png"
      ],
      "assessment": "The actual 2026 doctoral guide explicitly exempts foreign applicants from HMT online registration. Its March 2–6 material submission covers foreign applicants, ending March 6 at 17:00 Beijing time. HMT-only February 28 at 24:00 is retained solely as an excluded route; its normalized March 1 midnight is not used as the foreign deadline.",
      "candidateCutoffAt": "2026-03-06T17:00:00+08:00"
    },
    {
      "key": "btbu-matching-three-majors-finance-unmatched",
      "disposition": "accepted",
      "evidence": [
        "btbu.pdf pages 6–8,11",
        "btbu-programs-page6.png",
        "btbu-deadline-page11.png"
      ],
      "assessment": "The actual 2026 catalogue includes Business Administration, International Economics and Trade, and Polymer Materials and Engineering; their explicit applicant deadline May 1, 2026 supports three closed candidates. It lists Financial Management, which is not Finance. No Finance/金融学 entry is found across all three catalogue pages; that stored route remains unknown. No permanent discontinuation is inferred."
    },
    {
      "key": "bjut-programme-specific-absolute-window",
      "disposition": "accepted",
      "evidence": [
        "bjut.pdf pages 1–2",
        "bjut-date-page2.png"
      ],
      "assessment": "Exact English-taught International Economics and Trade bachelor programme has an explicitly year-bound November 1, 2025 to June 15, 2026 application period, September entry, and the matching 2026–2027 stored cycle. It supports one closed candidate and a separate numeric opening candidate, without opening-date equality certification."
    },
    {
      "key": "bupt-relative-months-not-hardened",
      "disposition": "accepted",
      "evidence": [
        "bupt.pdf pages 1,6,10",
        "independent-bupt-date-page-10.png"
      ],
      "assessment": "2026 brochure and four route names are present, but its application period states October 20 to April 20 next year without absolute endpoint years. The report conservatively retains four unknown deadlines and does not manufacture a 2025/2026 or 2026/2027 window."
    },
    {
      "key": "ccom-recurring-before-dates",
      "disposition": "accepted",
      "evidence": [
        "ccom.html",
        "ccom.txt section 五"
      ],
      "assessment": "The January 13, 2026 publication date does not establish the application year of generic spring/autumn fee references. Before January 1 and before June 15 remain recurring references with strict before qualifiers; four deadlines stay unknown."
    },
    {
      "key": "bwu-before-class-and-cueb-recurring-rule",
      "disposition": "accepted",
      "evidence": [
        "bwu-guide.html",
        "cueb-deadline.html"
      ],
      "assessment": "BWU any-time-before-class and approximate early-September intake do not provide an exact 2026 deadline. CUEB before June 10 each year is recurring and the stored bachelor intake is other; language-only spring before December 20 is excluded. All three remain unknown."
    }
  ],
