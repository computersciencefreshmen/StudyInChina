      "sourcePath": "quality/recovery-20261018/next-wave/ecnu/ecnu-gcp-2027.html",
      "sourceLines": [
        772,
        868
      ],
      "source": "the first week is orientation week; Come to ECNU on registration days.",
      "reason": "Orientation week does not publish registration days. The Chinese notes convert it into a first-week arrival/registration requirement while the English notes correctly say orientation.",
      "requiredCorrection": "第一周为迎新周，3月8日开课；具体报到日按学校指定日期。 Preserve null/unknown exact registration dates."
    },
    {
      "id": "ECNU-SEMANTIC-2",
      "severity": "blocking-for-complete-claim-boundary",
      "field": "entries[0].cycle.notes.en and notes.zh",
      "approvedPath": "quality/recovery-20261018/next-wave/ecnu/full-program-batch-approved-v1.json",
      "approvedLines": [
        171,
        172
      ],
      "claims": [
        "The separate 20:00 cutoff on the Chinese-language programme page is not used here.",
        "Do not apply lower fees or closed application dates from a different, older language-version page to this current Spring2027 guide."
      ],
      "reason": "This batch binds only the current GCP admissions page and application portal. Neither source capture establishes the claimed other-page 20:00 time, lower fees or closed dates. These cross-page maintenance comparisons are not fully source-backed applicant claims.",
      "requiredCorrection": "Remove the specific other-page comparisons. Retain the supported statement that this programme page does not publish an exact opening date or deadline time, plus the current guide fees and deadline."
    }
