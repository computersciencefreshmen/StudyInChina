NEXT_PUBLIC_SITE_URL=https://example.com
CONTENT_PREVIEW=false
CATALOG_BACKEND=json
CATALOG_API_URL=
CATALOG_API_TOKEN=
CATALOG_API_TOKEN_HOST=
CONTACT_RECIPIENT=contact@example.com
RESEND_API_KEY=
RESEND_FROM=StudyInChina <noreply@example.com>
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_SALT=

# Admin workbench: server-only secrets, each at least 32 characters.
# Use two independent cryptographically random values; never use NEXT_PUBLIC_ here.
ADMIN_ACCESS_TOKEN=
ADMIN_SESSION_SECRET=
# Default distributed mode requires Upstash in production. Set memory explicitly
# for a small private admin: five attempts/IP/hour per instance, resets on restart
# or cold start, no shared counters. Public feedback limiting is unchanged.
ADMIN_LOGIN_RATE_LIMIT_MODE=distributed
# Explicitly enable ONLY on a local/self-hosted Node machine that owns the verifier.
# Managed serverless deployments cannot observe or launch your computer's tasks.
ADMIN_LOCAL_VERIFICATION_ENABLED=false
# Read only CC Switch's current official MiniMax provider; requires explicit local opt-in.
ADMIN_VERIFICATION_USE_CCSWITCH=false
# Online controls require both this opt-in and a fresh control-capable bridge.
# A bridge launched with --telemetry-only intentionally cannot accept commands.
ADMIN_REMOTE_CONTROL_ENABLED=false
ADMIN_TELEMETRY_URL=
ADMIN_TELEMETRY_TOKEN=
# Alternative to CC Switch: configure an official MiniMax endpoint and server credential.
MINIMAX_API_KEY=
MINIMAX_API_URL=https://api.minimax.io/v1/chat/completions
MINIMAX_MODEL=MiniMax-M3.1-Flash-Preview
