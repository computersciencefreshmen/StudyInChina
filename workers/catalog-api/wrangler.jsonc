{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "studyinchina-catalog-api",
  "account_id": "b75f28d574289c29e9bda60a2fca27ed",
  "main": "./src/index.ts",
  "compatibility_date": "2026-07-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "vars": { "ADMIN_RELEASE_CONTROL_ENABLED": "false" },
  "services": [{ "binding": "MAINTENANCE_MONITOR", "service": "studyinchina-catalog-maintenance", "entrypoint": "MaintenanceMonitor" }],
  "d1_databases": [
    { "binding": "PIPELINE_DB", "database_name": "studyinchina-pipeline", "database_id": "43e2d4a5-54a4-4932-97f3-755be12ef8bb", "migrations_dir": "../../infra/d1/pipeline/migrations" },
    {
      "binding": "CATALOG_DB",
      "database_name": "studyinchina-catalog",
      "database_id": "491ecd37-db2d-4520-afef-8b7deb1c64c0",
      "migrations_dir": "../../infra/d1/catalog/migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "SOURCE_SNAPSHOTS", "bucket_name": "studyinchina-source-snapshots" },
    {
      "binding": "RELEASES_BUCKET",
      "bucket_name": "studyinchina-releases"
    }
  ]
}
