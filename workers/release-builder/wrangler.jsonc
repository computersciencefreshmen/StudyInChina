{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "studyinchina-release-builder",
  "account_id": "b75f28d574289c29e9bda60a2fca27ed",
  "main": "./src/index.ts",
  "compatibility_date": "2026-07-20",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "2,17,32,47 * * * *"
    ]
  },
  "vars": {
    "SCHEDULE_BATCH_LIMIT": "20",
    "PIPELINE_PAGE_SIZE": "500",
    "CATALOG_WRITE_BATCH_SIZE": "50",
    "MAX_QUEUE_ATTEMPTS": "4",
    "EVENT_LEASE_SECONDS": "900",
    "RUNTIME_RETRY_DELAY_SECONDS": "900"
  },
  "d1_databases": [
    {
      "binding": "PIPELINE_DB",
      "database_name": "studyinchina-pipeline",
      "database_id": "43e2d4a5-54a4-4932-97f3-755be12ef8bb",
      "migrations_dir": "../../infra/d1/pipeline/migrations"
    },
    {
      "binding": "CATALOG_DB",
      "database_name": "studyinchina-catalog",
      "database_id": "491ecd37-db2d-4520-afef-8b7deb1c64c0",
      "migrations_dir": "../../infra/d1/catalog/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RELEASE_ARTIFACTS",
      "bucket_name": "studyinchina-releases"
    },
    {
      "binding": "BUDGET_STATE_BUCKET",
      "bucket_name": "studyinchina-source-snapshots"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "RELEASE_QUEUE",
        "queue": "studyinchina-release-builder"
      },
      {
        "binding": "RELEASE_BUILDER_DLQ",
        "queue": "studyinchina-release-builder-dlq"
      }
    ],
    "consumers": [
      {
        "queue": "studyinchina-release-builder",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_retries": 4,
        "dead_letter_queue": "studyinchina-release-builder-dlq",
        "max_concurrency": 1
      }
    ]
  }
}
