{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "studyinchina-publisher",
  "account_id": "b75f28d574289c29e9bda60a2fca27ed",
  "main": "./src/index.ts",
  "compatibility_date": "2026-07-20",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "7,22,37,52 * * * *"
    ]
  },
  "vars": {
    "SCHEDULE_BATCH_LIMIT": "20",
    "MAX_QUEUE_ATTEMPTS": "4"
  },
  "r2_buckets": [{ "binding": "BUDGET_STATE_BUCKET", "bucket_name": "studyinchina-source-snapshots" }],
  "d1_databases": [
    {
      "binding": "PIPELINE_DB",
      "database_name": "studyinchina-pipeline",
      "database_id": "43e2d4a5-54a4-4932-97f3-755be12ef8bb",
      "migrations_dir": "../../infra/d1/pipeline/migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "PROMOTION_QUEUE",
        "queue": "studyinchina-promotion"
      },
      {
        "binding": "PUBLISHER_DLQ",
        "queue": "studyinchina-publisher-dlq"
      }
    ],
    "consumers": [
      {
        "queue": "studyinchina-promotion",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_retries": 4,
        "dead_letter_queue": "studyinchina-publisher-dlq",
        "max_concurrency": 1
      }
    ]
  }
}
