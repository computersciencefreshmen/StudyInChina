{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "studyinchina-localization",
  "main": "./src/index.ts",
  "compatibility_date": "2026-07-20",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "triggers": {
    "crons": ["37 * * * *"]
  },
  "vars": {
    "MINIMAX_API_URL": "https://api.minimaxi.com/v1/chat/completions",
    "MINIMAX_MODEL": "MiniMax-M2.7",
    "MINIMAX_TIMEOUT_MS": "30000",
    "MINIMAX_MAX_OUTPUT_TOKENS": "8192",
    "TRANSLATION_ENABLED": "false",
    "TRANSLATION_BATCH_ITEMS": "20",
    "TRANSLATION_BATCH_CHARACTERS": "30000",
    "TRANSLATION_SCHEDULE_ITEMS": "120",
    "TRANSLATION_MAX_ATTEMPTS": "4",
    "TRANSLATION_MONTHLY_API_CALLS": "20000",
    "TRANSLATION_MONTHLY_INPUT_CHARACTERS": "100000000",
    "TRANSLATION_DEFAULT_TARGETS": "zh,en,ru"
  },
  "d1_databases": [
    {
      "binding": "PIPELINE_DB",
      "database_name": "studyinchina-pipeline",
      "database_id": "bb68098a-1429-44ad-869a-de9c3a5e478c",
      "migrations_dir": "../../infra/d1/pipeline/migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "LOCALIZATION_QUEUE",
        "queue": "studyinchina-localization"
      }
    ],
    "consumers": [
      {
        "queue": "studyinchina-localization",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 4,
        "max_concurrency": 1
      }
    ]
  }
}

