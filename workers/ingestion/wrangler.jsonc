{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "studyinchina-ingestion",
  "account_id": "b75f28d574289c29e9bda60a2fca27ed",
  "main": "./src/index.ts",
  "compatibility_date": "2026-07-20",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  // The owner retired the legacy M2.7 model lane. Subscription-based expansion
  // runs through catalog-maintenance; retain ingestion data and read APIs only.
  "triggers": {
    "crons": []
  },
  "vars": {
    "USER_AGENT": "StudyInChinaDataBot/1.0 (+https://studyinchina.vercel.app/contact)",
    "SCHEDULE_BATCH_LIMIT": "100",
    "MAX_QUEUE_ATTEMPTS": "4",
    "DEFAULT_FETCH_TIMEOUT_MS": "15000",
    "DEFAULT_MAX_BYTES": "10485760",
    "MINIMAX_API_URL": "https://api.minimaxi.com/v1/chat/completions",
    "MINIMAX_MODEL": "MiniMax-M2.7",
    "MINIMAX_TIMEOUT_MS": "30000",
    "MINIMAX_MAX_INPUT_CHARS": "60000",
    "MINIMAX_MAX_OUTPUT_TOKENS": "8192",
    "DOCUMENT_CONVERSION_TIMEOUT_MS": "45000",
    "DOCUMENT_MAX_TEXT_CHARACTERS": "1000000",
    "INFRA_FORECAST_CNY": "0"
  },
  "browser": {
    "binding": "BROWSER"
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "INGESTION_DB",
      "database_name": "studyinchina-pipeline",
      "database_id": "43e2d4a5-54a4-4932-97f3-755be12ef8bb",
      "migrations_dir": "../../infra/d1/pipeline/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SNAPSHOTS_BUCKET",
      "bucket_name": "studyinchina-source-snapshots"
    },
    {
      "binding": "BUDGET_STATE_BUCKET",
      "bucket_name": "studyinchina-source-snapshots"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "INGESTION_QUEUE",
        "queue": "studyinchina-ingestion"
      },
      {
        "binding": "INGESTION_DLQ",
        "queue": "studyinchina-ingestion-dlq"
      },
      {
        "binding": "QUARANTINE_QUEUE",
        "queue": "studyinchina-ingestion-quarantine"
      }
    ],
    "consumers": []
  }
}
