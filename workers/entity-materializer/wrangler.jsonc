{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "studyinchina-entity-materializer",
  "account_id": "b75f28d574289c29e9bda60a2fca27ed",
  "main": "./src/index.ts",
  "compatibility_date": "2026-07-20",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },
  "vars": {
    "MATERIALIZATION_BATCH_LIMIT": "100",
    "RELEASE_CANDIDATE_LIMIT": "500"
  },
  "r2_buckets": [{ "binding": "BUDGET_STATE_BUCKET", "bucket_name": "studyinchina-source-snapshots" }],
  "d1_databases": [
    {
      "binding": "PIPELINE_DB",
      "database_name": "studyinchina-pipeline",
      "database_id": "43e2d4a5-54a4-4932-97f3-755be12ef8bb",
      "migrations_dir": "../../infra/d1/pipeline/migrations"
    }
  ]
}
