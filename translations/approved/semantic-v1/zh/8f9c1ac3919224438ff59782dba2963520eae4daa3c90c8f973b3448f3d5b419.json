{"factPolicy":"literal-v2","key":"d8d6cba6437ac51bca47e7e823097531b740dc8551c8c190169e8e72e468a4f3","method":"minimax","model":"MiniMax-M3","review":{"binding":"409887bf0a5196f89e7855e9ab8ef223d95f9da016828b0468dd43182908e5b4","checkedAt":"2026-11-27T04:04:41.700Z","model":"MiniMax-M3","policy":"semantic-v1","verdict":"PASS"},"schemaVersion":1,"sourceHash":"ecb6870d3c452e022d417e35f74f8b5f8fd0c788923af04b2363fd3c1b377c2a","targetLocale":"zh","text":"项目简介 美术学院设有基础部、油画系、版画系、雕塑系、壁画系、实验艺术系等。新生第一年须在基础部参加基础年课程学习，并在学年末获得相应资格证明。之后进入油画系、版画系、雕塑系、壁画系等专业系别学习。课程包括艺术史与理论、艺术批评、艺术管理、艺术品文物鉴定与修复及艺术考古学。考生须参加本科入学考试。现提供2011本科入学考试的相关信息供参考。","translatedAt":"2026-11-24T21:44:41.929Z","validation":"passed","version":"v1"}
