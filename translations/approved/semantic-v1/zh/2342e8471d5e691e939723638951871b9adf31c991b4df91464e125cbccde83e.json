{"factPolicy":"literal-v2","key":"c06a3cfb208d82840b430b9c979b7d6e3b9fc2d25ec5f65d96854c12efcbfc3e","method":"minimax","model":"MiniMax-M3","review":{"binding":"1f6a27c010dc691a0c50757aaff71622ec3c3e2aa2356395023a1c07950e386f","checkedAt":"2026-11-27T15:23:47.642Z","model":"MiniMax-M3","policy":"semantic-v1","verdict":"PASS"},"schemaVersion":1,"sourceHash":"7512c42ea4d386dd34ec8a531f0b1abd553d34d29c8e9af6ffbc8c254f2d42da","targetLocale":"zh","text":"电子商务（Electronic Commerce，简称 EC）是一门交叉学科，融合信息技术、管理学、营销学和法学等多学科知识，重点研究“通过互联网等电子手段进行商品交易、服务交付和经营活动”。其内容不仅包括人们熟悉的网上购物，还涵盖企业间在线协作、跨境电子商务、数字支付和数字供应链管理等广泛领域。该领域的核心是研究“如何利用数字技术优化业务流程并创造新的商业模式”。","translatedAt":"2026-11-25T00:39:54.553Z","validation":"passed","version":"v1"}
