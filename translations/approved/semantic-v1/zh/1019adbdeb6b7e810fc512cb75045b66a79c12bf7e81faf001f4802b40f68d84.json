{"factPolicy":"literal-v2","key":"27bbdcc0a5690413b31c0cf478cdd837bfd5fd8e36c1ba3b73f5c1771c1313e5","method":"minimax","model":"MiniMax-M3","review":{"binding":"ac7a8cd5448305c29cffbb3168589fc96ff2c81958779f83d0858062072791ae","checkedAt":"2026-11-27T09:23:26.513Z","model":"MiniMax-M3","policy":"semantic-v1","verdict":"PASS"},"schemaVersion":1,"sourceHash":"cf9dc324e5e46618c2378225fa394fcda5e334d48c36b01f0b90c269960fdda4","targetLocale":"zh","text":"微生物学是生命科学领域的重要基础分支，研究微生物生物学活动的规律及其与自然界的联系。随着分子生物学的发展，微生物学研究已进入分子生物学研究时期，并成为其重要前沿学科之一，体现了总体发展方向。微生物学博士点于2000年获批。共有6个研究方向，包括分子生物学固氮与基因工程、分子病毒学与基因工程、微生物生物技术、食品微生物学及微生物资源利用。","translatedAt":"2026-11-25T14:31:54.766Z","validation":"passed","version":"v1"}
