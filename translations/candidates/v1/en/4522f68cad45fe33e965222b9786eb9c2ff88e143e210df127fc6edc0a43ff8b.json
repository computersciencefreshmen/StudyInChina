rEl)) var mobile_nav = document.querySelector('.mobile-nav-toggle'); if (mobile_nav) { mobile_nav.addEventListener('click', function (e) { document.querySelector('#navbar').classList.toggle('navbar-mobile'); this.classList.toggle('bi-list'); this.classList.toggle('bi-x'); }) } var navbardrop = document.querySelector('.navbar .dropdown > a'); if (navbardrop) { document.querySelector('.navbar .dropdown > a').addEventListener('click', function (e) { if (document.querySelector('#navbar').classList.contains('navbar-mobile')) { e.preventDefault(); this.nextElementSibling.classList.toggle('dropdown-active'); } }, true); } var btn_scroll_top = document.querySelector(\".btn-scroll-top\"); // Get the \"Back to Top\" button element if (btn_scroll_top) { // Check whether the element exists const footerBar = document.querySelector('.footer-bar'); var threshold = parseInt(450, 10); // Set the scroll threshold to 450 var circle = btn_scroll_top.querySelector(\"svg circle\"); // Get the SVG circle element var length = circle.getTotalLength(); // Get the total length of the circular path circle.style.strokeDasharray = length; // Set the circular path style circle.style.strokeDashoffset = length; // Set the initial offset of the circular path window.addEventListener(\"scroll\", function (e) { // Listen for page scroll events if (e.currentTarget.pageYOffset > threshold) { btn_scroll_top.classList.add(\"show\") } else { btn_scroll_top.classList.remove(\"show\") footerBar.classList.remove(\"show\") }; // Show or hide the \"Back to Top\" button based on scroll distance var progress = (document.body.scrollTop + document.documentElement.scrollTop) / (document.documentElement.scrollHeight - document.documentElement.clientHeight); circle.style.strokeDashoffset = length - length * progress; }); }","translatedAt":"2026-11-23T10:19:10.459Z","validation":"passed","version":"v1"}
